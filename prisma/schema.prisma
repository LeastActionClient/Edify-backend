generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  lastActivity DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs      ActivityLog[]
  addedStudents Student[] @relation("AddedStudents")
  processedApplications Application[] @relation("ProcessedApplications")
  recordedPayments Payment[] @relation("RecordedPayments")
  createdIncludedCharges IncludedCharge[] @relation("CreatedIncludedCharges")
  createdActivities Activity[] @relation("CreatedActivities")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Application {
  id              String            @id @default(uuid())
  applicationId   String            @unique
  adminNo         String?
  studentName     String
  fatherName      String
  motherName      String
  fatherPhone     String
  motherPhone     String
  address         String
  applyingClass   String
  previousSchool  String?
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(PENDING)
  feePaid         Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  siblings        Json?

  processedById   String?
  processedBy     User?             @relation("ProcessedApplications", fields: [processedById], references: [id])

  student         Student?
}

model Student {
  id              String   @id @default(uuid())
  admissionNumber String   @unique
  applicationId   String?  @unique
  application     Application? @relation(fields: [applicationId], references: [id])
  
  addedById       String?
  addedBy         User?    @relation("AddedStudents", fields: [addedById], references: [id])
  
  studentName     String
  fatherName      String
  motherName      String
  fatherPhone     String
  motherPhone     String
  address         String
  currentClass    String
  section         String?
  siblings        Json?
  
  photoUrl             String?
  dateOfBirth          DateTime?
  gender               String?
  bloodGroup           String?
  aadhaarNumber        String?
  religion             String?
  community            String?
  nationality          String?
  email                String?
  rollNumber           String?
  admissionDate        DateTime?
  academicYear         String?
  studentStatus        String?
  fatherOccupation     String?
  motherOccupation     String?
  guardian             String?
  city                 String?
  state                String?
  pincode              String?
  baseFee              Float?
  includedChargesTotal Float?
  activitiesTotal      Float?
  grandTotal           Float?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentFees     StudentFee[]
  payments        Payment[]
  invoices        Invoice[]
  includedCharges StudentIncludedCharge[]
  activities      StudentActivity[]
}

model Class {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  defaultFees Json?

  sections  Section[]
}

model Section {
  id        String   @id @default(uuid())
  name      String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  defaultFees Json?

  @@unique([name, classId])
}

model FeeCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentFees StudentFee[]
}

model StudentFee {
  id             String      @id @default(uuid())
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id])
  feeCategoryId  String
  feeCategory    FeeCategory @relation(fields: [feeCategoryId], references: [id])
  totalAmount    Float
  paidAmount     Float       @default(0)
  remainingAmount Float
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  payments       Payment[]
}

model Payment {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  studentFeeId    String
  studentFee      StudentFee    @relation(fields: [studentFeeId], references: [id])
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   String
  referenceNumber String?
  remarks         String?
  status          PaymentStatus @default(PAID)
  
  recordedById    String?
  recordedBy      User?         @relation("RecordedPayments", fields: [recordedById], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice         Invoice?
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  generatedDate DateTime @default(now())
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id                String   @id @default("global")
  nextApplicationNo String?
  nextAdmissionNo   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IncludedCharge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  amount      Float
  status      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CreatedIncludedCharges", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    StudentIncludedCharge[]
}

model Activity {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  amount      Float
  status      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CreatedActivities", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    StudentActivity[]
}

model StudentIncludedCharge {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  includedChargeId String
  includedCharge   IncludedCharge @relation(fields: [includedChargeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([studentId, includedChargeId])
}

model StudentActivity {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, activityId])
}
